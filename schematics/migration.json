{
  "$schema": "./node_modules/@angular-devkit/schematics/collection-schema.json",
  "schematics": {
    "migration-v22": {
      "version": "22",
      "description": "Updates NG-ALAIN to v22 [https://github.com/ng-alain/ng-alain/issues/2635]",
      "factory": "./ng-update/index#updateToV22"
    },
    "ng-post-update": {
      "description": "Performs cleanup after ng-update.",
      "factory": "./ng-update/index#postUpdate",
      "private": true
    }
  }
}
