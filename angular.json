{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": {
    "packageManager": "yarn",
    "analytics": false
  },
  "projects": {
    "site": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "less"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "src/dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "src/tsconfig.json",
            "polyfills": [
              "@webcomponents/custom-elements",
              "@webcomponents/custom-elements/src/native-shim"
            ],
            "assets": [
              "src/assets",
              "src/manifest.json",
              "src/robots.txt",
              "src/llms.txt",
              "src/llms-full.txt",
              "src/llms-full-cn.txt",
              {
                "glob": "**/*.md",
                "input": "src/llms",
                "output": "/llms/"
              },
              {
                "glob": "**/jszip.min.js",
                "input": "./node_modules/jszip/dist",
                "output": "assets/jszip/"
              },
              {
                "glob": "**/qrious.min.js",
                "input": "./node_modules/qrious/dist",
                "output": "assets/qrious/"
              },
              {
                "glob": "{build,web}/**",
                "input": "./node_modules/pdfjs-dist/",
                "ignore": ["*.js.map", "*.d.ts"],
                "output": "assets/pdfjs/"
              },
              {
                "glob": "**/{plyr.min.js,plyr.css,plyr.svg}",
                "input": "./node_modules/plyr/dist",
                "output": "assets/plyr/"
              }
            ],
            "styles": [
              "src/styles.less"
            ],
            "inlineStyleLanguage": "less",
            "stylePreprocessorOptions": {
              "includePaths": ["node_modules/"]
            },
            "scripts": [
            ],
            "allowedCommonJsDependencies": [
              "codesandbox/lib/api/define",
              "hammerjs",
              "ajv",
              "file-saver",
              "ajv-formats",
              "date-fns",
              "extend"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json",
              "server": "src/main.server.ts",
              "prerender": {
                "routesFile": "scripts/site/route-paths.txt"
              },
              "ssr": {
                "entry": "src/server.ts"
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "::production"
            },
            "development": {
              "buildTarget": "::development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "delon": {
      "sourceRoot": "packages",
      "root": "packages",
      "projectType": "library",
      "prefix": "",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "tsConfig": "packages/tsconfig.lib.prod.json"
          },
          "configurations": {
            "development": {
              "polyfills": []
            }
          },
          "defaultConfiguration": "development"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "fix": true,
            "lintFilePatterns": [
              "packages/**/*.ts",
              "packages/**/*.html"
            ]
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "delon:build:development",
            "runner": "vitest",
            "runnerConfig": "packages/vitest.config.mts",
            "browsers": ["ChromiumHeadless"],
            "browserViewport": "800x600",
            "providersFile": "packages/test-providers.ts",
            "setupFiles": ["packages/vitest-setup.ts"],
            "isolate": true,
            "coverageReporters": ["html", "text-summary", "lcovonly", "cobertura"],
            "coverageExclude": ["packages/testing/**", "packages/abc/st/test/**", "packages/form/spec/**"],
            "reporters": ["default", ["junit", { "outputFile": "junit/TESTS-vitest.xml" }]],
            "include": ["**/*.spec.ts"]
          }
        }
      }
    }
  }
}
